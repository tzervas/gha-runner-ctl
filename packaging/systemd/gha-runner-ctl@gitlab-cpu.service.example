# Environment=GHA_FORGE=gitlab
# Environment=GHA_GITLAB_URL=https://git.vectorweight.com
# Environment=GITLAB_RUNNER_IMAGE=docker.io/gitlab/gitlab-runner:alpine-v17.5.3
# ExecStart=/usr/local/bin/secret exec GITLAB_TOKEN=gitlab/api-token -- \
#   /home/gha-agent/.local/bin/gha-runner-ctl listen --forge gitlab ...
